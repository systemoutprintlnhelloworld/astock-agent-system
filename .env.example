# Copy this file to .env or set variables in your shell.
# Never commit real API keys or tokens.

# OpenAI-compatible LLM gateway
LLM_BASE_URL=https://example.com/v1
LLM_API_KEY=
LLM_DEFAULT_MODEL=
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=3
LLM_MAX_TOKENS=128
LLM_USER_AGENT=
LLM_REQUEST_PROFILE=auto

# Market data providers
TUSHARE_TOKEN=
DATA_MODE=offline
OFFLINE_DATA_PATH=data/samples/stocks.json

# Storage services from docker-compose.yml
MONGO_URI=mongodb://localhost:27017
MONGO_DB=astock_agent_system
MONGO_TIMEOUT_MS=3000
REDIS_URL=redis://localhost:6379/0

# Portfolio and risk defaults. Override in CLI as needed.
INITIAL_CAPITAL=100000
MAX_POSITION_PER_STOCK=0.10
MAX_TOTAL_POSITION=0.50
STOP_LOSS_PCT=0.05

# Notification adapters
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
EMAIL_TO=
NOTIFY_WEBHOOK_URL=

# smart-search integration
SMART_SEARCH_ENABLED=false
SMART_SEARCH_TIMEOUT_SECONDS=60

# Scheduler. Keep disabled by default for local development.
SCHEDULER_ENABLED=false
SCHEDULER_TIMEZONE=Asia/Shanghai
SCHEDULER_DAILY_RUN_TIME=15:05
STOP_LOSS_INTERVAL_MINUTES=5
SCHEDULER_NOTIFY_AFTER_DAILY_RUN=false
SCHEDULER_MAX_COUNT=3
SCHEDULER_HISTORY_DAYS=24
SCHEDULER_OUTPUT_DIR=reports
# Comma-separated model IDs for automatic daily paper-investment rounds.
# Example: rule-baseline,gpt-5.4-mini,codex-auto-review
SCHEDULER_MODELS=rule-baseline

#!/bin/sh

echo "Post-commit check complete."

if [ "${AUTO_PUSH_AFTER_COMMIT:-0}" != "1" ]; then
  echo "Auto-push is disabled by default. Run 'git push' manually, or set AUTO_PUSH_AFTER_COMMIT=1."
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
echo "AUTO_PUSH_AFTER_COMMIT=1 set; pushing $BRANCH..."

git push origin "$BRANCH" 2>/dev/null || {
  echo "  WARNING: push failed. You may need to pull first or check network."
  exit 0
}

echo "  OK: pushed to $BRANCH"

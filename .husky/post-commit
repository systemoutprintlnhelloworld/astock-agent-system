#!/bin/sh

echo "Post-commit check complete."

if [ "${SKIP_AUTO_PUSH:-0}" = "1" ]; then
  echo "SKIP_AUTO_PUSH=1 set; skipping automatic push."
  exit 0
fi

BRANCH=$(git rev-parse --abbrev-ref HEAD)
if [ "$BRANCH" = "HEAD" ]; then
  echo "  ERROR: detached HEAD; cannot auto-push safely."
  exit 1
fi

REMOTE=${GIT_PUSH_REMOTE:-origin}
echo "Auto-pushing $BRANCH to $REMOTE..."

if git rev-parse --abbrev-ref --symbolic-full-name "@{u}" >/dev/null 2>&1; then
  git push "$REMOTE" "$BRANCH" || {
    echo "  ERROR: push failed. Please check network, credentials, or remote branch state."
    exit 1
  }
else
  git push -u "$REMOTE" "$BRANCH" || {
    echo "  ERROR: initial push failed. Please check network, credentials, or remote permissions."
    exit 1
  }
fi

echo "  OK: pushed $BRANCH to $REMOTE"

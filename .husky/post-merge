#!/bin/sh

echo "Checking documentation consistency..."

CHANGED_CODE=$(git diff --name-only HEAD@{1} HEAD | sed -n '/^src\//p;/^apps\//p')

if [ -n "$CHANGED_CODE" ]; then
  echo "  WARNING: code files changed; check if documentation needs an update:"
  echo "$CHANGED_CODE" | sed 's/^/    - /'
  echo ""
  echo "  Documentation checklist:"
  echo "    - docs/technical/ARCHITECTURE.md (if architecture changed)"
  echo "    - docs/technical/FLOWS.md (if flows changed)"
  echo "    - docs/technical/USER_NEEDS_MAPPING.md (if API changed)"
  echo "    - docs/USER_GUIDE.md (if user-facing features changed)"
  echo ""
fi

echo "  OK: documentation consistency check complete."

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AStock Agent System",
  "version": "0.1.0",
  "identifier": "com.astock.agent-system",
  "build": {
    "beforeDevCommand": "npm --prefix ../frontend run dev -- --hostname 127.0.0.1 --port 3000",
    "beforeBuildCommand": "npm --prefix ../frontend run build:desktop",
    "devUrl": "http://127.0.0.1:3000",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "AStock Agent System",
        "width": 1440,
        "height": 960,
        "minWidth": 1100,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/astock-backend"],
    "resources": {
      "../../../config": "config",
      "../../../data/samples": "data/samples"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
